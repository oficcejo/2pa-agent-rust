# =============================================================================
# okx-2pa-agent-web 环境配置示例
# 请复制为项目根目录的 .env，填写密钥后重启服务。
# .env 已被 Git 忽略，禁止提交、截图公开或发送给他人。
# =============================================================================

# ------------------------------ LLM 配置 ------------------------------
# OpenAI 兼容接口的 API Key；示例文件不填写真实密钥。
LLM_API_KEY=
# 当前 .env 默认使用 DeepSeek 官方或兼容接口；更换服务商时按其文档填写兼容接口根地址。
LLM_BASE_URL=https://api.deepseek.com
# 默认模型名称：deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
# 默认关闭思考模式；服务商支持且需要时可改为 true。
LLM_THINKING=false
# 思考强度：low、medium、high 或 max。
LLM_REASONING_EFFORT=high
# 模型上下文窗口大小，需不超过服务商限制。
LLM_CONTEXT_WINDOW=128000
# 阶段一、阶段二各自的最大等待秒数，范围 30-1800。
LLM_STAGE_TIMEOUT_SECONDS=240

# ------------------------------ OKX 凭据 ------------------------------
# 必须使用同一个模拟盘或实盘环境创建的三项凭据。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OKX REST API 地址，通常保持不变。
OKX_BASE_URL=https://www.okx.com

# ------------------------------ 交易环境 ------------------------------
# true=模拟盘，false=实盘。首次部署必须使用 true。
OKX_DEMO_TRADING=true
# 服务启动时是否开启后台自动交易，建议保持 false。
OKX_AUTO_TRADING_ENABLED=false
# 实盘必须明确确认，并且同时设置下面的 YES 开关。
OKX_LIVE_TRADING_ACKNOWLEDGED=false
OKX_ENABLE_LIVE_TRADING=YES

# ------------------------------ 订单与风控 ------------------------------
# 固定下单数量。现货通常是基础币数量；SWAP/FUTURES 通常是合约张数；请计算好投入本金和获取张数，比如ETH，100USDT约等于0.05，比特币更小。
OKX_DEFAULT_ORDER_SIZE=1
# 新开 SWAP/FUTURES 仓位前使用的默认杠杆，不修改已有仓位。
OKX_DEFAULT_LEVERAGE=3
# cash=普通现货，cross=全仓，isolated=逐仓。
OKX_TRADE_MODE=cross
# net=单向持仓，long_short=双向持仓，必须和 OKX 账户设置一致。
OKX_POSITION_MODE=net
# true=已有衍生品仓位时阻止继续加仓或反向开仓。
OKX_BLOCK_NEW_ENTRIES_WHEN_POSITION_OPEN=true
# 信号超过该秒数（从已收盘 K 线收盘时间计算）后不执行。
OKX_MAX_SIGNAL_AGE_SECONDS=120
# 全未成交开仓挂单超过该数量的已收盘 K 线后自动撤销。
OKX_MAX_PENDING_BARS=3
# 后台检查新收盘 K 线的间隔秒数，不代表固定下单频率。
OKX_AUTOMATION_POLL_SECONDS=20
# 自动交易分析时段：always、us_regular、us_open、london、asia 或 custom。
OKX_AUTOMATION_SESSION_PRESET=always
# custom 模式使用 IANA 时区、HH:MM 时间和星期编号（周一=0，周日=6）。
OKX_AUTOMATION_SESSION_TIMEZONE=Asia/Shanghai
OKX_AUTOMATION_SESSION_START=09:00
OKX_AUTOMATION_SESSION_END=16:00
OKX_AUTOMATION_SESSION_WEEKDAYS=0,1,2,3,4
